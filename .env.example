# ====================================================================
# FairShift — Environment Configuration Example
# Copy this file to .env.local to configure external Supabase integration
# ====================================================================

# Public Supabase URL (e.g., https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co

# Public Supabase Anonymous Key (Safe to expose to browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-eyJhbGciOi...

# Supabase Service Role Key (NEVER expose to client; used for server-side administrative jobs only)
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-eyJhbGciOi...

# Application Environment Mode ('demo' or 'production')
# When set to 'demo' (or if credentials are left blank), FairShift runs in local stateful demo mode
# with realistic seeded datasets for both Construction and University Facilities industries.
NEXT_PUBLIC_APP_MODE=demo
